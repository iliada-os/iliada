# Το πρόγραμμα εγκατάστασης της Ιλιάδας (Ελληνικά).

install-iliada = Εγκατάσταση της Ιλιάδας
language = Γλώσσα
welcome-body = Η Ιλιάδα θα εγκατασταθεί στον δίσκο αυτού του υπολογιστή. Μπορείτε επίσης να συνεχίσετε να τη δοκιμάζετε: τίποτα δεν αλλάζει μέχρι να το επιβεβαιώσετε, σε λίγα βήματα.
keep-trying = Συνέχεια δοκιμής της Ιλιάδας
continue = Συνέχεια
back = Πίσω

## Disk
disk = Δίσκος
removable = (αφαιρούμενος)
other-files = άλλα αρχεία
the-other-system = άλλο σύστημα
disks-failed = Δεν ήταν δυνατή η εμφάνιση των δίσκων: { $error }
no-disk = Δεν υπάρχει δίσκος τουλάχιστον 20 GB για την εγκατάσταση. Συνδέστε έναν, μετά πηγαίνετε πίσω και δοκιμάστε ξανά.
next-to =
    { $kind ->
        [other] Δίπλα στα υπάρχοντα αρχεία, στα { $free } ελεύθερου χώρου
       *[system] Δίπλα στο { $what }, στα { $free } ελεύθερου χώρου
    }
erase-whole =
    { $kind ->
        [other] Διαγραφή των υπαρχόντων αρχείων και χρήση ολόκληρου του δίσκου
       *[system] Διαγραφή του { $what } και χρήση ολόκληρου του δίσκου
    }
needs-free =
    { $kind ->
        [other] Για να κρατήσει τα υπάρχοντα αρχεία, η Ιλιάδα χρειάζεται { $need } ελεύθερου χώρου δίπλα τους· αυτός ο δίσκος έχει { $free }.
       *[system] Για να κρατήσει το { $what }, η Ιλιάδα χρειάζεται { $need } ελεύθερου χώρου δίπλα του· αυτός ο δίσκος έχει { $free }.
    }
whole-empty = Χρήση ολόκληρου του δίσκου (είναι άδειος)
where-title = Πού να εγκατασταθεί η Ιλιάδα;
where-body = Η Ιλιάδα μπορεί να μπει δίπλα σε ό,τι υπάρχει ήδη σε έναν δίσκο, αν χωράει, ή να το αντικαταστήσει.

## About you
your-name = Το όνομά σας
account-name = Όνομα λογαριασμού
computer-name = Όνομα υπολογιστή
password = Κωδικός πρόσβασης
repeat-password = Επανάληψη του κωδικού πρόσβασης
time-zone = Ζώνη ώρας
tz-found = Βρέθηκε από τη σύνδεσή σας στο διαδίκτυο.
hint-user = Το όνομα λογαριασμού μπορεί να έχει πεζά λατινικά γράμματα, ψηφία, - και _.
hint-hostname = Το όνομα υπολογιστή μπορεί να έχει λατινικά γράμματα, ψηφία και -.
hint-passwords = Οι κωδικοί πρόσβασης δεν ταιριάζουν.
about-you = Σχετικά με εσάς
about-you-body = Ο λογαριασμός σας είναι διαχειριστή: μπορεί να εγκαθιστά εφαρμογές και να αλλάζει ρυθμίσεις.

## Time zone regions
region-africa = Αφρική
region-america = Αμερική
region-antarctica = Ανταρκτική
region-arctic = Αρκτική
region-asia = Ασία
region-atlantic = Ατλαντικός
region-australia = Αυστραλία
region-europe = Ευρώπη
region-indian = Ινδικός Ωκεανός
region-pacific = Ειρηνικός
region-other = Άλλες

## Confirm
confirm-keep-title =
    { $kind ->
        [other] Εγκατάσταση της Ιλιάδας δίπλα στα υπάρχοντα αρχεία;
       *[system] Εγκατάσταση της Ιλιάδας δίπλα στο { $what };
    }
confirm-keep-body =
    { $kind ->
        [other] Τα υπάρχοντα αρχεία μένουν όπως είναι. Όταν ξεκινά ο υπολογιστής, ξεκινά η Ιλιάδα· για να ξεκινήσει κάτι άλλο, ανοίξτε το μενού εκκίνησης (συνήθως F9, F12 ή Esc καθώς ξεκινά ο υπολογιστής).
       *[system] Το { $what } μένει όπως είναι. Όταν ξεκινά ο υπολογιστής, ένα μενού σάς αφήνει να επιλέξετε την Ιλιάδα ή το { $what }. Αν το { $what } δεν είναι εκεί, το μενού εκκίνησης του ίδιου του υπολογιστή το βρίσκει (συνήθως F9, F12 ή Esc καθώς ξεκινά ο υπολογιστής).
    }
install = Εγκατάσταση
confirm-erase-title = Διαγραφή του δίσκου και εγκατάσταση της Ιλιάδας;
confirm-erase-body = Όλα όσα υπάρχουν σε αυτόν τον δίσκο θα διαγραφούν. Αυτό δεν αναιρείται.
erase-and-install = Διαγραφή και εγκατάσταση
confirm-summary = { $name } ({ $user }) στον υπολογιστή «{ $hostname }», ζώνη ώρας { $timezone }, στα { $language }.

## Installing
installing-title = Εγκατάσταση της Ιλιάδας
installing-body = Αυτό διαρκεί λίγη ώρα: η Ιλιάδα κατεβαίνει και ρυθμίζεται για αυτόν τον υπολογιστή. Κρατήστε τον συνδεδεμένο στο διαδίκτυο και στο ρεύμα.
stage-preparing = Προετοιμασία
stage-room = Δημιουργία χώρου στον δίσκο (όλα όσα έχει μένουν)
stage-partitioning = Διαμέριση του δίσκου
stage-mounting = Προσάρτηση
stage-configuration = Εγγραφή των ρυθμίσεων
stage-installing = Εγκατάσταση της Ιλιάδας (γίνεται λήψη και δημιουργία του συστήματος)
stage-password = Ορισμός του κωδικού πρόσβασης
stage-done = Ολοκληρώθηκε

## Done
installed-title = Η Ιλιάδα εγκαταστάθηκε
installed-body = Αφαιρέστε το USB (ή τον δίσκο) εγκατάστασης και κάντε επανεκκίνηση. Συνδεθείτε με τον κωδικό πρόσβασης που επιλέξατε.
restart-now = Επανεκκίνηση τώρα
failed-title = Η εγκατάσταση δεν ολοκληρώθηκε
failed-body = Τίποτα σε αυτόν τον υπολογιστή δεν είναι ακόμη έτοιμο για χρήση. Ελέγξτε τη σύνδεση στο διαδίκτυο και δοκιμάστε ξανά.
quit = Έξοδος
try-again = Δοκιμή ξανά
start-failed = δεν ήταν δυνατή η εκκίνηση του προγράμματος εγκατάστασης: { $error }
install-failed = η εγκατάσταση απέτυχε
