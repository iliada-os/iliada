<!-- Homer: a front-facing bronze bust. Blind (eyes closed), bearded,
       a red fillet in his hair, a short neck centred under the head,
       draped shoulders on a small socle. -->
  <g transform="translate(128 127) scale(1.1) translate(-128 -133)">
  <!-- socle and base -->
  <path fill="#A5671F" d="M110 190 H146 L154 208 H102 Z"/>
  <rect x="80" y="204" width="96" height="14" rx="4" fill="#8A5418"/>
  <rect x="80" y="204" width="96" height="5" rx="2.5" fill="url(#hm-base)"/>
  <!-- neck, shaded under the jaw -->
  <rect x="114" y="122" width="28" height="40" fill="url(#hm-neck)"/>
  <!-- shoulders and drape -->
  <path fill="url(#hm-drape)" d="M58 200 C56 180 68 166 94 158 L116 154 C121 161 135 161 140 154 L162 158 C188 164 200 180 198 200 C180 206 150 194 128 194 C106 194 76 206 58 200 Z"/>
  <!-- himation over the left shoulder -->
  <path fill="#A5671F" opacity="0.6" d="M74 166 C88 160 100 160 108 168 C124 184 156 192 196 194 C197 196 198 198 198 200 C190 202 182 201 174 199 C150 194 124 190 104 184 C88 180 72 184 60 192 C60 182 64 174 74 168 Z"/>
  <path fill="none" stroke="#8A5418" stroke-width="2" stroke-linecap="round" opacity="0.6" d="M66 186 C84 176 102 178 118 184 M150 168 C164 172 176 180 182 190"/>
  <path fill="#FFF1CC" opacity="0.4" d="M64 186 C64 176 74 166 92 161 C80 168 72 176 70 186 Z"/>
  <!-- hair mass behind the face -->
  <path fill="url(#hm-hair)" d="M92 100 C88 68 104 48 128 48 C152 48 168 68 164 100 C164 114 160 124 154 128 H102 C96 124 92 114 92 100 Z"/>
  <!-- face -->
  <ellipse cx="128" cy="103" rx="27" ry="32" fill="url(#hm-face)"/>
  <!-- hair over the forehead, with curls -->
  <path fill="url(#hm-hair)" d="M98 86 C97 66 110 58 128 58 C146 58 159 66 158 86 C146 76 110 76 98 86 Z"/>
  <g fill="none" stroke="#7A4612" stroke-width="2.4" stroke-linecap="round" opacity="0.75">
    <path d="M103 69 C105 62 112 60 116 63"/>
    <path d="M120 61 C124 55 132 55 136 60"/>
    <path d="M140 63 C144 60 151 62 153 69"/>
    <path d="M94 104 C94 98 98 96 101 98"/>
    <path d="M162 104 C162 98 158 96 155 98"/>
    <path d="M94 116 C95 111 98 110 101 112"/>
    <path d="M162 116 C161 111 158 110 155 112"/>
  </g>
  <!-- fillet -->
  <path fill="url(#il-crest)" d="M96 83 C108 72 148 72 160 83 L160 91 C148 80 108 80 96 91 Z"/>
  <!-- brows, closed eyes (Homer was blind), nose -->
  <g fill="none" stroke-linecap="round">
    <path stroke="#A5671F" stroke-width="2.4" d="M110 97 C114 94 120 94 124 96 M146 97 C142 94 136 94 132 96"/>
    <path stroke="#7A4612" stroke-width="2.6" d="M111 104 C114 107 119 107 122 104 M145 104 C142 107 137 107 134 104"/>
    <path stroke="#B57A30" stroke-width="2.2" d="M128 100 V114 M124 117 C126 118 130 118 132 117"/>
  </g>
  <!-- beard and moustache -->
  <path fill="url(#hm-hair)" d="M101 110 C101 124 106 136 114 142 C119 146 124 148 128 148 C132 148 137 146 142 142 C150 136 155 124 155 110 C151 118 146 122 140 121 C135 120 131 119 128 121 C125 119 121 120 116 121 C110 122 105 118 101 110 Z"/>
  <path fill="none" stroke="#5A3410" stroke-width="2.2" stroke-linecap="round" d="M122 127 C126 129 130 129 134 127"/>
  <g fill="none" stroke="#5A3410" stroke-width="1.8" stroke-linecap="round" opacity="0.5">
    <path d="M110 126 C111 132 114 137 118 140"/>
    <path d="M146 126 C145 132 142 137 138 140"/>
    <path d="M121 133 C122 138 124 141 126 144"/>
    <path d="M135 133 C134 138 132 141 130 144"/>
  </g>
  <path fill="#FFF1CC" opacity="0.35" d="M104 72 C108 62 116 58 124 57 C116 62 110 68 108 78 Z"/>
  </g>
